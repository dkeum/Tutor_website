{
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/book-a-call",
      "destination": "/book-a-call.html"
    },
    {
      "source": "/(.*)",
      "destination": "/"
    }
  ]
}